        cdef double lex, ley
        with nogil:
            lex = self.lex
            ley = self.ley
            self.Sw_y[6] = 2*((-eta - 2)*(0.125*eta - 0.125)*(-xi - 2)*(xi - 1)**2 - 0.0625*(eta - 1)**2*(-xi - 2)*(xi - 1)**2)/ley
            self.Sw_y[7] = 2*(0.03125*lex*(-eta - 2)*(2*eta - 2)*(-xi - 1)*(xi - 1)**2 - 0.03125*lex*(eta - 1)**2*(-xi - 1)*(xi - 1)**2)/ley
            self.Sw_y[8] = 2*(0.03125*ley*(-eta - 1)*(2*eta - 2)*(-xi - 2)*(xi - 1)**2 - 0.03125*ley*(eta - 1)**2*(-xi - 2)*(xi - 1)**2)/ley
            self.Sw_y[9] = 2*(0.015625*lex*ley*(-eta - 1)*(2*eta - 2)*(-xi - 1)*(xi - 1)**2 - 0.015625*lex*ley*(eta - 1)**2*(-xi - 1)*(xi - 1)**2)/ley
            self.Sw_y[16] = 2*(0.0625*(-eta - 2)*(2*eta - 2)*(xi - 2)*(xi + 1)**2 - 0.0625*(eta - 1)**2*(xi - 2)*(xi + 1)**2)/ley
            self.Sw_y[17] = 2*(-0.03125*lex*(-eta - 2)*(2*eta - 2)*(xi - 1)*(xi + 1)**2 + 0.03125*lex*(eta - 1)**2*(xi - 1)*(xi + 1)**2)/ley
            self.Sw_y[18] = 2*(0.03125*ley*(-eta - 1)*(2*eta - 2)*(xi - 2)*(xi + 1)**2 - 0.03125*ley*(eta - 1)**2*(xi - 2)*(xi + 1)**2)/ley
            self.Sw_y[19] = 2*(-0.015625*lex*ley*(-eta - 1)*(2*eta - 2)*(xi - 1)*(xi + 1)**2 + 0.015625*lex*ley*(eta - 1)**2*(xi - 1)*(xi + 1)**2)/ley
            self.Sw_y[26] = 2*((0.125*eta + 0.125)*(eta - 2)*(xi - 2)*(xi + 1)**2 + 0.0625*(eta + 1)**2*(xi - 2)*(xi + 1)**2)/ley
            self.Sw_y[27] = 2*(-0.03125*lex*(eta - 2)*(2*eta + 2)*(xi - 1)*(xi + 1)**2 - 0.03125*lex*(eta + 1)**2*(xi - 1)*(xi + 1)**2)/ley
            self.Sw_y[28] = 2*(-0.03125*ley*(eta - 1)*(2*eta + 2)*(xi - 2)*(xi + 1)**2 - 0.03125*ley*(eta + 1)**2*(xi - 2)*(xi + 1)**2)/ley
            self.Sw_y[29] = 2*(0.015625*lex*ley*(eta - 1)*(2*eta + 2)*(xi - 1)*(xi + 1)**2 + 0.015625*lex*ley*(eta + 1)**2*(xi - 1)*(xi + 1)**2)/ley
            self.Sw_y[36] = 2*((0.125*eta + 0.125)*(eta - 2)*(-xi - 2)*(xi - 1)**2 + 0.0625*(eta + 1)**2*(-xi - 2)*(xi - 1)**2)/ley
            self.Sw_y[37] = 2*(0.03125*lex*(eta - 2)*(2*eta + 2)*(-xi - 1)*(xi - 1)**2 + 0.03125*lex*(eta + 1)**2*(-xi - 1)*(xi - 1)**2)/ley
            self.Sw_y[38] = 2*(-0.03125*ley*(eta - 1)*(2*eta + 2)*(-xi - 2)*(xi - 1)**2 - 0.03125*ley*(eta + 1)**2*(-xi - 2)*(xi - 1)**2)/ley
            self.Sw_y[39] = 2*(-0.015625*lex*ley*(eta - 1)*(2*eta + 2)*(-xi - 1)*(xi - 1)**2 - 0.015625*lex*ley*(eta + 1)**2*(-xi - 1)*(xi - 1)**2)/ley


cpdef void update_KC0(BFSCCylinder shell,
                      double [::1] points,
                      double [::1] weights,
                      long [::1] KC0r,
                      long [::1] KC0c,
                      double [::1] KC0v,
                      ):
    r"""Update sparse vectors for linear constitutive stiffness matrix KC0

    The element matrix, with ``40*40`` entries, is integrated with the
    integration points and weights given by ``points`` and ``weights``,
    from ``lex``, ``ley``, ``R`` and the stiffnesses ``A11, ..., D66`` of
    ``shell``. All its entries are written: the global row and column
    indices to ``KC0r`` and ``KC0c``, and the values added to ``KC0v``, at
    the positions ``shell.init_k_KC0`` to ``shell.init_k_KC0 +
    KC0_SPARSE_SIZE - 1``. Before this function is called, ``c1, c2, c3,
    c4``, ``init_k_KC0``, ``lex``, ``ley``, ``R`` and the stiffnesses of
    ``shell`` must be set.

    Parameters
    ----------
    shell : :class:`.BFSCCylinder` object
        The cylindrical shell element being added to KC0
    points : np.array
        Integration poins
        1-D array of ``DOUBLE`` of size ``nint``, the ``nint`` given to the
        constructor of ``shell``, with natural coordinates from ``-1`` to
        ``1``, e.g. from :func:`bfsccylinder.quadrature.get_points_weights`.
        Used in both directions, for ``nint*nint`` integration points.
    weights : np.array
        Integration weights
        1-D array of ``DOUBLE`` of the same size as ``points``.
    KC0r : np.array
        Array to store row positions of sparse values
        1-D array of integers (``INT``) of size at least
        ``init_k_KC0 + KC0_SPARSE_SIZE``.
    KC0c : np.array
        Array to store column positions of sparse values
        Same type and size as ``KC0r``.
    KC0v : np.array
        Array to store sparse values
        1-D array of ``DOUBLE``, same size as ``KC0r``. The values are
        added to the existing ones.
        Dimension of force per unit length between the displacements `u`, `v`,
        `w`, multiplied by a length for each of the row and the column that is
        a first derivative, and by a length squared for each that is `w_{,xy}`.

    See Also
    --------
    update_KCNL, update_KG

    Notes
    -----
    KC0 is the Hessian of the strain energy of the Notes of
    :mod:`bfsccylinder.bfsccylinder` with the linear strains only,
    `\boldsymbol{\varepsilon} = \boldsymbol{\varepsilon}_L`:

    .. math::

        \boldsymbol{K}_{C0} = \int_A \left( \boldsymbol{B}_m^\top \boldsymbol{A} \boldsymbol{B}_m + \boldsymbol{B}_m^\top \boldsymbol{B} \boldsymbol{B}_b
                   + \boldsymbol{B}_b^\top \boldsymbol{B} \boldsymbol{B}_m + \boldsymbol{B}_b^\top \boldsymbol{D} \boldsymbol{B}_b \right) dA

    with the rows `\boldsymbol{B}_m` and `\boldsymbol{B}_b` of :meth:`.BFSCCylinder.update_Bm` and
    :meth:`.BFSCCylinder.update_Bb`, evaluated at each integration point as
    the local variables ``Bm1_*``, ``Bm2_*``, ``Bm3_*``, ``Bb1_*``, ``Bb2_*``
    and ``Bb3_*``, and the `\boldsymbol{A}`, `\boldsymbol{B}` and `\boldsymbol{D}` of that point. KC0 does not
    depend on the displacements: it is the stiffness matrix of a linear static
    analysis and the tangent stiffness matrix at zero displacements.

