                fext[9 + c3] += 0.25*Sw1_30*az*lex*ley*pij*weight
                fext[0 + c4] += 0.25*Su1_31*ax*lex*ley*pij*weight
                fext[1 + c4] += 0.25*Su1_32*ax*lex*ley*pij*weight
